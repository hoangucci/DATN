  m_Name: 
  m_EditorClassIdentifier: 
  storyPanel: {fileID: 1898134983}
  storyCanvasGroup: {fileID: 1898134986}
  storyText: {fileID: 824849970}
  continueHintText: {fileID: 290655793}
  skipButton: {fileID: 947878999}
  panelClickButton: {fileID: 424096729}
  backgroundBlackOverlay: {fileID: 1898134984}
  storyLines:
  - "Chuy\u1EBFn bay g\u1EB7p s\u1EF1 c\u1ED1 b\u1EA5t th\u01B0\u1EDDng do t\u1EEB
    tr\u01B0\u1EDDng m\u1EA1nh...\n\nM\xE1y bay m\u1EA5t ki\u1EC3m so\xE1t v\xE0
    r\u01A1i t\u1EF1 do xu\u1ED1ng m\u1ED9t h\xF2n \u0111\u1EA3o b\xED \u1EA9n b\u1ECB
    bao ph\u1EE7 b\u1EDFi N\u0103ng L\u01B0\u1EE3ng H\u1ED7n Mang."
  - "B\u1EA1n t\u1EC9nh d\u1EADy tr\xEAn b\u1EDD b\xE3i bi\u1EC3n hoang s\u01A1.\n\nT\u1EA5t
    c\u1EA3 thi\u1EBFt b\u1ECB \u0111i\u1EC7n t\u1EED \u0111\u1EC1u h\u01B0 h\u1ECFng.
    Kh\xF4ng kh\xED tr\xEAn \u0111\u1EA3o tr\xE0n ng\u1EADp n\u0103ng l\u01B0\u1EE3ng
    bi\u1EBFn \u0111\u1ED5i nguy hi\u1EC3m."
  - "N\u0103ng l\u01B0\u1EE3ng H\u1ED7n Mang khi\u1EBFn c\xE1c sinh v\u1EADt tr\u1EDF
    n\xEAn hung t\u1EE3n.\n\nKhi qu\xE1i v\u1EADt ch\u1EBFt, l\xF5i n\u0103ng l\u01B0\u1EE3ng
    c\u1EE7a ch\xFAng s\u1EBD nh\u1EADp v\xE0o \u0111\u1ED3ng lo\u1EA1i g\u1EA7n
    nh\u1EA5t, bu\u1ED9c c\u01A1 th\u1EC3 ch\xFAng ph\u1EA3i bi\u1EBFn \u0111\u1ED5i
    ti\u1EBFn h\xF3a l\xEAn d\u1EA1ng nguy hi\u1EC3m h\u01A1n."
  - "B\u1EA1n kh\xF4ng th\u1EC3 s\u1EED d\u1EE5ng tr\u1EF1c ti\u1EBFp ngu\u1ED3n
    n\u0103ng l\u01B0\u1EE3ng n\xE0y.\n\nC\xE1ch duy nh\u1EA5t \u0111\u1EC3 s\u1ED1ng
    s\xF3t: Khai th\xE1c t\xE0i nguy\xEAn, s\u0103n qu\xE1i v\u1EADt d\u1EA1ng cu\u1ED1i
    \u0111\u1EC3 l\u1EA5y Chaos Shard, v\xE0 ch\u1EBF t\u1EA1o m\u1ED9t Con Thuy\u1EC1n
    \u0111\u1EB7c bi\u1EC7t \u0111\u1EC3 v\u01B0\u1EE3t bi\u1EC3n tho\xE1t kh\u1ECFi
    \u0111\u1EA3o!"
  typewriterSpeed: 0.035
  triggerOnStart: 0
  targetSceneOnComplete: ProceduralCombatDemo
  onStoryCompleted:
    m_PersistentCalls:
      m_Calls: []
